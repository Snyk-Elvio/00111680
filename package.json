{
  "name": "mailer-service-nestjs",
  "version": "1.41.0",
  "description": "description",
  "author": "",
  "license": "MIT",
  "scripts": {
    "dev": "./CI/setup.sh && tsc -p ./tsconfig.build.json && concurrently -n \"compile,api,worker\" \"npm run tsc-watch\" \"npm run start:debug\" \"npm run start:sqs-worker:debug\"",
    "build": "tsc -p tsconfig.build.json",
    "db:create-migration": "ts-node ./node_modules/.bin/typeorm migration:generate -d migrations -n",
    "db:migrate": "IS_MIGRATION='true' npx typeorm-ts-node-commonjs migration:run -d ./dataSource.ts",
    "db:seed": "IS_SEEDING='true' npx typeorm-ts-node-commonjs migration:run -d ./dataSource.ts",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "lint": "eslint -c .eslintrc.js --ext .ts ./",
    "lint:fix": "eslint -c .eslintrc.js --ext .ts ./ --fix",
    "precommit": "lint-staged",
    "prepush": "echo 'If you changed the build, make sure to bump the version of docker/imageName' && npm run lint && npm run format:check && npm run test",
    "tsc-watch": "tsc -p ./tsconfig.build.json -w",
    "start:debug": "nodemon --config nodemon.api.debug.json",
    "start:sqs-worker:debug": "nodemon --config nodemon.worker.debug.json",
    "start:prod:app": "node dist/main.js",
    "start:prod:sqs-worker": "node dist/sqs-worker.js",
    "test": "jest --silent",
    "test:cov": "jest --config unit-coverage.config.js tests/unit",
    "test:debug": "node --inspect-brk -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:watch": "jest --watch",
    "test:integration": "jest --config ./tests/integration/jest-integration.json",
    "test:integration:debug": "node --inspect node_modules/.bin/jest --config ./tests/integration/jest-integration.json --watch --runInBand",
    "tslint-check": "tslint-config-prettier-check ./tslint.json",
    "test:e2e": "docker-compose up e2e",
    "test:e2e:local": "cd ./e2e && RUN_LOCAL='true' node ./tests.js"
  },
  "husky": {
    "hooks": {
      "pre-push": "npm run prepush",
      "post-merge": "rimraf dist"
    }
  },
  "dependencies": {
    "@adsk/acs-nestjs-apigee": "^10.0.0",
